# PostgreSQL 连接地址。请复制为本机环境变量或未提交的 .env 后再替换密码。
DATABASE_URL=postgres://minifeel:replaceMe@127.0.0.1:5432/minifeel

# 项目文件、生成素材和运行数据的本地目录。
MINIFEEL_DATA_DIR=./data

# 可选：旧版项目所在的绝对目录。用户只能复制导入此目录下第一层文件夹。
MINIFEEL_LEGACY_WORKSPACE_DIR=

# 32 字节随机密钥的 Base64 文本，用于加密供应商 API Key。
MINIFEEL_SECRET_KEY=

# 仅供开发环境连接本机模拟供应商；生产环境始终要求 HTTPS。
MINIFEEL_ALLOW_INSECURE_PROVIDER_URLS=false

# 仅在数据库尚无管理员时使用，初始化完成后不会覆盖现有管理员。
MINIFEEL_ADMIN_PHONE=+8613800000000
MINIFEEL_ADMIN_PASSWORD=changeBeforeFirstRun

# V1 本地开发开关。关闭验证码模拟后必须接入真实短信发送实现。
MINIFEEL_AUTH_MOCK_CODE=true
MINIFEEL_AUTH_MOCK_GOOGLE=true

# 会话有效天数。
MINIFEEL_SESSION_DAYS=30

# 同进程生成任务 Worker 的全局并发数，以及失联任务的判定秒数。
MINIFEEL_GENERATION_CONCURRENCY=4
MINIFEEL_GENERATION_STALE_SECONDS=120

# 应用监听端口。
PORT=3000
